rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Users Collection Rules: users/{userId}
    match /users/{userId} {
      // Allow user to read their own document
      allow read: if request.auth != null && request.auth.uid == userId;

      // Allow initial document creation during registration
      allow create: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;

      // Allow profile updates (e.g. name, avatar) but block tampering with protected fields
      allow update: if request.auth != null 
                    && request.auth.uid == userId
                    // Ensure immutable system fields are not modified by client
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.email == resource.data.email
                    && request.resource.data.role == resource.data.role
                    // Validate field types & lengths
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 100;

      // Client deletion is blocked (account deletion is managed securely via backend Admin SDK)
      allow delete: if false;

      // 3. User-specific Sightings Subcollection: users/{userId}/sightings/{sightingId}
      match /sightings/{sightingId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // 4. Public Sightings Collection (if used for public feed): sightings/{sightingId}
    match /sightings/{sightingId} {
      // Public verified sightings can be read by any authenticated user
      allow read: if request.auth != null;
      // Creation allowed for authenticated users attributing to their own UID
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      // Update/delete only permitted for the owner or backend admin
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
