# ===================================================
# WildAtlas (WATLAS) - Environment Configuration
# ===================================================

# --- Frontend Client Configuration (client/.env) ---
# Primary Vector Road Basemap (OpenFreeMap Bright Style)
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Fallback Tile Provider
VITE_TILE_URL_FALLBACK=https://tile.openstreetmap.org/{z}/{x}/{y}.png
# OSRM Engine Endpoint
VITE_OSRM_BASE_URL=http://localhost:5000/api/routes

# Firebase Web Client SDK Credentials (from Firebase Console -> Project Settings -> General -> Your Apps)
VITE_FIREBASE_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_FIREBASE_AUTH_DOMAIN=your-wildatlas-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-wildatlas-project
VITE_FIREBASE_STORAGE_BUCKET=your-wildatlas-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# --- Backend Express Server Configuration (server/.env) ---
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
OSRM_BASE_URL=http://localhost:5001

# Google Gemini API Key (for AI species guide and vision identification)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK Configuration (Production Service Credentials)
# Option 1: Place serviceAccountKey.json in the server/ directory
# Option 2: Set the environment variables below:
FIREBASE_PROJECT_ID=your-wildatlas-project
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-wildatlas-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"
